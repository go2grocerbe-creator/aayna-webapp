# ─── AAYNA backend environment (example) ───
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.

# Required admin credentials (used to seed the dashboard admin account)
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=change-this-password

# Required: long random secret for signing JWT tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-long-random-secret

# Environment: "development" (default, allows dev fallbacks) or "production" (strict).
# In production the app refuses to start if JWT_SECRET/ADMIN_EMAIL/ADMIN_PASSWORD are
# missing or left at their defaults.
APP_ENV=development

# Only relevant when APP_ENV=production: by default an empty production DB is
# NOT auto-filled with the demo catalogue on startup. Set this to true only if
# you deliberately want the demo/placeholder catalogue seeded in production.
ALLOW_PRODUCTION_SEED=false

# Database (this app uses MongoDB). DATABASE_URL is an alias for documentation.
#
# AAYNA uses three logically separate databases, distinguished only by name
# (same local MongoDB instance is fine for dev/test). NEVER point automated
# tests at your real development database - see ENVIRONMENTS.md.
#   development : aayna_dev      (local backend, local frontend, founder QA)
#   test        : aayna_pytest   (pytest / automated tests ONLY - must contain
#                                 "test"; backend/tests/conftest.py refuses to
#                                 run any test otherwise, and drops this
#                                 database after every test session)
#   production  : set via real deployment environment config, never here
DATABASE_URL=
MONGO_URL=mongodb://localhost:27017
DB_NAME=aayna_dev

# CORS allowed origins (comma-separated). Use the real frontend URL in production.
CORS_ORIGINS=*

# Public site URL used to build absolute SEO URLs (canonical, Open Graph,
# robots.txt sitemap reference, and sitemap.xml entries). Set this to your real
# live domain before launch. Safe local fallback is http://localhost:3000.
PUBLIC_SITE_URL=https://your-domain.com

# Product image storage (Cloudflare R2). Keep credentials server-side. The
# public base URL is the approved custom domain, without a trailing slash.
IMAGE_UPLOADS_ENABLED=false
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://images.example.com

# Legacy category-image storage only; product galleries do not use this.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
EMERGENT_LLM_KEY=

# Steadfast courier. Credentials and live mode do not enable parcel creation by
# themselves: STEADFAST_REAL_BOOKINGS also requires explicit founder approval.
STEADFAST_MODE=off
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_REAL_BOOKINGS=false
STEADFAST_PAYMENTS_SCHEMA_VERIFIED=false
CRON_SECRET=

# Order notification webhook (Milestone 3B).
# When ORDER_WEBHOOK_ENABLED=true and ORDER_WEBHOOK_URL is set, a POST with the
# order payload is sent after each successful order. ORDER_WEBHOOK_SECRET (optional)
# adds an HMAC-SHA256 X-AAYNA-Signature header so the receiver can verify authenticity.
# NEVER commit a real webhook URL or secret.
ORDER_WEBHOOK_URL=
ORDER_WEBHOOK_ENABLED=false
ORDER_WEBHOOK_SECRET=

# Notification router metadata (Milestone 3D).
# Logical name/mode of the downstream automation router (Make.com, Blackbox AI, n8n, etc.).
# These are recorded in notification_logs for traceability. The app stays webhook-only —
# ORDER_WEBHOOK_URL is the actual outbound endpoint; no SDKs or direct SMS/email are sent.
NOTIFICATION_ROUTER_NAME=generic_webhook
NOTIFICATION_ROUTER_MODE=webhook

# Cost-based pricing rule (import/repricing scripts only, never the web server).
# BUSINESS-CONFIDENTIAL: set the founder's values only in the real, git-ignored
# backend/.env on the machine that runs scripts/import_inventory.py
# (--cost-price-rule) or scripts/reprice_from_cost.py. Never commit them.
# AAYNA_PRICE_EXTRA_BDT=
# AAYNA_PRICE_MULTIPLIER=
